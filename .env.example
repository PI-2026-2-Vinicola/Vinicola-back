# Copie para .env e ajuste. Nenhum valor real deve ser versionado.

# "development" ou "production". Em produção a API não inicia com configuração insegura
# (JWT_SECRET padrão/curto, PUBLIC_READ=true ou CORS "*"). Valide com: python -m app.cli check-config
ENVIRONMENT=development

# Banco de dados (SQLAlchemy). Padrão: SQLite local.
# PostgreSQL: postgresql+psycopg://oasis:SENHA@localhost:5432/oasis   (pip install "psycopg[binary]")
# MySQL:      mysql+pymysql://oasis:SENHA@localhost:3306/oasis         (pip install pymysql)
DATABASE_URL=sqlite:///./oasis.db

# Segurança — gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Administrador criado na primeira inicialização (somente se o banco não tiver usuários).
# Senha vazia → uma senha aleatória é gerada e exibida uma única vez no terminal da API.
OASIS_ADMIN_EMAIL=admin@oasis.agr.br
OASIS_ADMIN_NAME=Administrador OASIS
OASIS_ADMIN_PASSWORD=

# Análise das imagens: "auto" (YOLO se o arquivo de pesos existir; senão análise de cor),
# "color" (sempre análise de cor) ou "yolo" (exige o arquivo de pesos).
OASIS_DETECTOR=auto
OASIS_MODEL_PATH=models/oasis-grapes.pt
OASIS_MODEL_CONFIDENCE=0.35

# Fuso da propriedade (indicadores por dia) e nome exibido no painel (opcional).
OASIS_TIMEZONE=America/Recife
OASIS_FARM_NAME=

# Armazenamento e limites de upload/importação
STORAGE_DIR=storage
MAX_UPLOAD_MB=8
MAX_IMPORT_MB=10
MAX_IMPORT_ROWS=20000

# Tempo máximo (segundos) da análise de uma imagem (detector + classificação)
OASIS_ANALYSIS_TIMEOUT_SECONDS=30

# Sensor considerado offline após N × intervalo de captura sem comunicação
SENSOR_OFFLINE_FACTOR=3

# Leitura de dados sem login. Mantenha false (obrigatório em produção).
PUBLIC_READ=false

# Origens liberadas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Usado apenas pelo docker compose (senha do PostgreSQL)
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ ThingSpeak (página Monitoramento)
# A API lê o canal pela API REST de leitura (https://www.mathworks.com/help/thingspeak/readdata.html).
#   Canal público: basta THINGSPEAK_CHANNEL_ID.
#   Canal privado: também THINGSPEAK_READ_API_KEY (aba "API Keys" do canal no ThingSpeak).
# As credenciais MQTT de um dispositivo (client ID, usuário e senha) servem para publicar/assinar no
# broker MQTT do ThingSpeak e NÃO dão acesso à API REST: pertencem ao dispositivo e não entram aqui.
# Teste com: python -m app.cli check-integrations
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_API_URL=https://api.thingspeak.com
THINGSPEAK_TIMEOUT_SECONDS=10
# Cache das leituras e atualização automática do painel, em segundos (mínimo 15 para ambos)
THINGSPEAK_CACHE_SECONDS=15
THINGSPEAK_REFRESH_SECONDS=60
# Unidades dos campos, se informadas pelo responsável pelo canal (ex.: field1=°C,field2=%). Vazio = sem unidade.
THINGSPEAK_FIELD_UNITS=

# ------------------------------------------------------------------ Embrapa AgroAPI (aba Uvas)
# Aplicação criada na loja https://www.agroapi.cnptia.embrapa.br/store/ (Applications → Production Keys)
# e inscrita (Subscribe) nas APIs RespondeAgro v1 e Agritec v2. A API OASIS gera e renova o token OAuth2.
EMBRAPA_CONSUMER_KEY=
EMBRAPA_CONSUMER_SECRET=
EMBRAPA_API_URL=https://api.cnptia.embrapa.br
EMBRAPA_TIMEOUT_SECONDS=15
# Cache em horas: RespondeAgro (gratuito até 100 mil req/mês) e Agritec (gratuito por 1 mês e até 1.000 req)
EMBRAPA_CACHE_HOURS=24
EMBRAPA_AGRITEC_CACHE_HOURS=168
# Livro da Coleção 500 Perguntas 500 Respostas consultado na aba Uvas
EMBRAPA_BOOK_ID=uva
# Consultas públicas à Embrapa permitidas por IP e por minuto
EMBRAPA_RATE_LIMIT_PER_MINUTE=30
