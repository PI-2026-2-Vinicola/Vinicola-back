# Copie para .env e ajuste. Nenhum valor real deve ser versionado.

# "development" ou "production". Em produção a API não inicia com configuração insegura
# (JWT_SECRET padrão/curto, PUBLIC_READ=true ou CORS "*"). Valide com: python -m app.cli check-config
ENVIRONMENT=development

# Banco de dados (SQLAlchemy). Padrão: SQLite local.
# PostgreSQL: postgresql+psycopg://oasis:SENHA@localhost:5432/oasis   (pip install "psycopg[binary]")
# MySQL:      mysql+pymysql://oasis:SENHA@localhost:3306/oasis         (pip install pymysql)
DATABASE_URL=sqlite:///./oasis.db

# Segurança — gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Administrador criado na primeira inicialização (somente se o banco não tiver usuários).
# Senha vazia → uma senha aleatória é gerada e exibida uma única vez no terminal da API.
OASIS_ADMIN_EMAIL=admin@oasis.agr.br
OASIS_ADMIN_NAME=Administrador OASIS
OASIS_ADMIN_PASSWORD=

# Análise das imagens: "auto" (YOLO se o arquivo de pesos existir; senão análise de cor),
# "color" (sempre análise de cor) ou "yolo" (exige o arquivo de pesos).
OASIS_DETECTOR=auto
OASIS_MODEL_PATH=models/oasis-grapes.pt
OASIS_MODEL_CONFIDENCE=0.35

# Fuso da propriedade (indicadores por dia) e nome exibido no painel (opcional).
OASIS_TIMEZONE=America/Recife
OASIS_FARM_NAME=

# Armazenamento e limites de upload/importação
STORAGE_DIR=storage
MAX_UPLOAD_MB=8
MAX_IMPORT_MB=10
MAX_IMPORT_ROWS=20000

# Sensor considerado offline após N × intervalo de captura sem comunicação
SENSOR_OFFLINE_FACTOR=3

# Leitura de dados sem login. Mantenha false (obrigatório em produção).
PUBLIC_READ=false

# Origens liberadas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Usado apenas pelo docker compose (senha do PostgreSQL)
POSTGRES_PASSWORD=
