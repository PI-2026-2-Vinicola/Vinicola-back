# Banco de dados (SQLAlchemy). Padrão: SQLite local.
# PostgreSQL: postgresql+psycopg://osais:osais@localhost:5432/osais
# MySQL:      mysql+pymysql://osais:osais@localhost:3306/osais
DATABASE_URL=sqlite:///./osais.db

# Segurança
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_MINUTES=720

# Detector de visão computacional: "mock" (simulado) ou "yolo" (modelo real)
OSAIS_DETECTOR=mock
OSAIS_MODEL_PATH=models/osais-grapes.pt
OSAIS_MODEL_CONFIDENCE=0.35

# Armazenamento das imagens recebidas
STORAGE_DIR=storage

# Popular o banco com dados de demonstração na primeira execução
SEED_DEMO=true

# Leitura pública (GET) sem login — útil para demonstração. Use false em produção.
PUBLIC_READ=true

# Origens liberadas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
